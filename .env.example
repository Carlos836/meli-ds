# Environment variables for Meli DS project

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/meli_db

# API Keys
MLFLOW_TRACKING_URI=http://localhost:5000
WANDB_API_KEY=your_wandb_api_key_here

# Model Configuration
MODEL_VERSION=1.0.0
RANDOM_STATE=42

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/meli-ds.log

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
